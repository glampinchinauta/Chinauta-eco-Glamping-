rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Toda la información se lee y se escribe a través de la API del servidor (cuenta de servicio),
    // que valida permisos y datos. Desde el navegador no se permite acceso directo a ninguna colección.
    // Así las reservas y los datos de los huéspedes nunca quedan expuestos públicamente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
