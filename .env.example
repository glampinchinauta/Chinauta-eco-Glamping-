# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GA_MEASUREMENT_ID: ID de medición de Google Analytics (G-XXXXXXXXXX). Vacío = no se carga analítica.
VITE_GA_MEASUREMENT_ID=""

# ------------------------------------------------------------------
# Datos en Firestore (ver docs/FIRESTORE.md)
# ------------------------------------------------------------------
# Cuenta de servicio de Firebase, en base64 (recomendado) o como JSON en una línea.
# Sin esto el servidor local usa memoria y los datos se pierden al reiniciar.
FIREBASE_SERVICE_ACCOUNT_BASE64=""
# FIREBASE_SERVICE_ACCOUNT=""
# Opcionales: si no se ponen, se toman de firebase-applet-config.json
# FIREBASE_PROJECT_ID=""
# FIRESTORE_DATABASE_ID=""
# FIREBASE_STORAGE_BUCKET=""
# Correos con permiso de administrador, separados por coma
ADMIN_EMAILS="ecoglampingventas@gmail.com"
